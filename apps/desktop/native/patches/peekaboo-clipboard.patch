--- /dev/null
+++ b/Core/PeekabooAutomationKit/Sources/PeekabooAutomationKit/Services/System/ClipboardItems.swift
@@ -0,0 +1,173 @@
+import AppKit
+import Foundation
+import ImageIO
+import PeekabooFoundation
+import UniformTypeIdentifiers
+
+/// Typed, bounded clipboard payloads shared by the GUI owner and its authenticated client.
+public struct ClipboardValue: Codable, Sendable {
+    public enum Kind: String, Codable, Sendable { case text, image, files }
+    public let kind: Kind
+    public let text: String?
+    public let image: Data?
+    public let paths: [String]?
+
+    public init(kind: Kind, text: String? = nil, image: Data? = nil, paths: [String]? = nil) {
+        self.kind = kind
+        self.text = text
+        self.image = image
+        self.paths = paths
+    }
+
+    public func writeRequest() throws -> ClipboardWriteRequest {
+        let items: [[ClipboardRepresentation]]
+        switch self.kind {
+        case .text:
+            guard let text, text.utf16.count <= 8192, image == nil, paths == nil else {
+                throw Self.invalid("Text must contain at most 8,192 UTF-16 code units.")
+            }
+            items = [[.init(utiIdentifier: NSPasteboard.PasteboardType.string.rawValue, data: Data(text.utf8))]]
+        case .image:
+            guard let image, text == nil, paths == nil else { throw Self.invalid("Supply one image.") }
+            let info = try Self.imageInfo(image)
+            items = [[.init(utiIdentifier: info.uti, data: image)]]
+        case .files:
+            guard let paths, !paths.isEmpty, paths.count <= 32, text == nil, image == nil,
+                  try JSONEncoder().encode(self).count <= 24_000,
+                  paths.allSatisfy({ $0.hasPrefix("/") && !$0.contains("\0") && $0.utf16.count <= 4096 })
+            else { throw Self.invalid("Supply 1–32 complete absolute local file paths within 24 KB.") }
+            items = paths.map { path in
+                let url = URL(fileURLWithPath: path)
+                return [.init(utiIdentifier: NSPasteboard.PasteboardType.fileURL.rawValue,
+                              data: Data(url.absoluteString.utf8))]
+            }
+        }
+        return ClipboardWriteRequest(representations: items[0], items: items)
+    }
+
+    public static func imageInfo(_ data: Data) throws -> ClipboardImageInfo {
+        guard !data.isEmpty, data.count <= 10 * 1024 * 1024,
+              let source = CGImageSourceCreateWithData(data as CFData, nil),
+              let type = CGImageSourceGetType(source) as String?,
+              let mime = [UTType.png.identifier: "image/png", UTType.jpeg.identifier: "image/jpeg",
+                          UTType.tiff.identifier: "image/tiff"][type],
+              CGImageSourceGetCount(source) == 1,
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+              let width = properties[kCGImagePropertyPixelWidth] as? NSNumber,
+              let height = properties[kCGImagePropertyPixelHeight] as? NSNumber,
+              width.doubleValue > 0, height.doubleValue > 0,
+              width.doubleValue * height.doubleValue <= 64_000_000
+        else { throw Self.invalid("Use one PNG, JPEG, or TIFF image of at most 10 MiB and 64 million pixels.") }
+        return .init(mimeType: mime, uti: type, bytes: data.count)
+    }
+
+    static func invalid(_ message: String) -> DesktopActionFailure {
+        .preDispatchRefusal(reason: .invalidRequest, message: message)
+    }
+}
+
+public struct ClipboardImageInfo: Codable, Sendable {
+    public let mimeType: String
+    public let uti: String
+    public let bytes: Int
+}
+
+public struct ClipboardContents: Codable, Sendable {
+    public let kind: ClipboardValue.Kind
+    public var present = false
+    public var text: String?
+    public var paths: [String]?
+    public var image: ClipboardImageInfo?
+    public var imageData: Data?
+    public let change_count: Int
+}
+
+@MainActor
+extension ClipboardService {
+    public func readItems(kind: ClipboardValue.Kind) throws -> ClipboardContents {
+        try Self.requireSilentReadAccess(self.readAccessStatus())
+        let generation = self.pasteboard.changeCount
+        var result = ClipboardContents(kind: kind, change_count: generation)
+        guard let items = self.pasteboard.pasteboardItems else { throw ClipboardTemporaryWriteError.snapshotUnavailable }
+        switch kind {
+        case .text:
+            if self.pasteboard.types?.contains(.string) == true {
+                guard let value = self.pasteboard.string(forType: .string) else {
+                    throw ClipboardTemporaryWriteError.snapshotUnavailable
+                }
+                result.present = true
+                result.text = value
+            }
+        case .image:
+            let supported = [NSPasteboard.PasteboardType.png, .tiff,
+                             NSPasteboard.PasteboardType(UTType.jpeg.identifier)]
+            if let type = supported.first(where: { self.pasteboard.types?.contains($0) == true }) {
+                guard let data = self.pasteboard.data(forType: type) else {
+                    throw ClipboardTemporaryWriteError.snapshotUnavailable
+                }
+                let info = try ClipboardValue.imageInfo(data)
+                guard info.uti == type.rawValue else {
+                    throw ClipboardValue.invalid("The clipboard image representation does not match its declared type.")
+                }
+                result.present = true
+                result.image = info
+                result.imageData = data
+            }
+        case .files:
+            guard !items.contains(where: { item in
+                item.types.contains { $0.rawValue.localizedCaseInsensitiveContains("promise") }
+            }) else { throw ClipboardValue.invalid("Promised clipboard files are unsupported; copy materialized files or folders.") }
+            var paths: [String] = []
+            for item in items where item.types.contains(.fileURL) {
+                guard let string = item.string(forType: .fileURL), let url = URL(string: string),
