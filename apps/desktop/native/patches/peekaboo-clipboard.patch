+import Foundation
+import PeekabooAutomationKit
+import PeekabooFoundation
+
+public struct PeekabooBridgeClipboardPasteRequest: Codable, Sendable {
+    public let snapshot: String
+    public let value: ClipboardValue
+    public init(snapshot: String, value: ClipboardValue) { self.snapshot = snapshot; self.value = value }
+}
+
+public struct PeekabooBridgeClipboardError: Codable, Sendable {
+    public let code: String
+    public let message: String
+    public var hint: String?
+}
+
+public struct PeekabooBridgeClipboardReceipt: Codable, Sendable {
+    public let pid: Int32
+    public let window_id: Int
+    public let process_start_identity_decimal: String
+}
+
+/// Mutation replies contain no original or replacement clipboard payload.
+public struct PeekabooBridgeClipboardMutation: Codable, Sendable {
+    public var outcome: String
+    public var native_outcome: DesktopActionOutcome?
+    public var clipboard_changed: Bool
+    public var clipboard_cleanup: String?
+    public var consumption: String?
+    public var requires_fresh_observation = false
+    public var error: PeekabooBridgeClipboardError?
+    public var target_receipt: PeekabooBridgeClipboardReceipt?
+}
+
+extension PeekabooBridgeClient {
+    public func clipboardRead(kind: ClipboardValue.Kind) async throws -> ClipboardContents {
+        guard case let .clipboardContents(contents) = try await self.send(.clipboardRead(kind)) else {
+            throw PeekabooBridgeErrorEnvelope(code: .internalError, message: "Unexpected clipboard read response")
+        }
+        return contents
+    }
+
+    public func clipboardWrite(value: ClipboardValue) async throws -> PeekabooBridgeClipboardMutation {
+        guard case let .clipboardMutation(result) = try await self.send(.clipboardWrite(value)) else {
+            throw PeekabooBridgeErrorEnvelope(code: .internalError, message: "Unexpected clipboard write response")
+        }
+        return result
+    }
+
+    public func clipboardPaste(snapshot: String, value: ClipboardValue) async throws -> PeekabooBridgeClipboardMutation {
+        guard case let .clipboardMutation(result) = try await self.send(.clipboardPaste(.init(snapshot: snapshot, value: value))) else {
+            throw PeekabooBridgeErrorEnvelope(code: .internalError, message: "Unexpected clipboard paste response")
+        }
+        return result
+    }
+}
+
+@MainActor
+extension PeekabooBridgeServer {
+    func handleClipboardRequest(_ request: PeekabooBridgeRequest) async throws -> PeekabooBridgeHandledResponse {
+        try await ClipboardPasteTransactionGate.withExclusiveTransaction {
+            try PeekabooBridgeRequestContext.checkRequestIsActive()
+            switch request {
+            case let .clipboardRead(kind):
+                return try .init(response: .clipboardContents(self.clipboard.readItems(kind: kind)))
+            case let .clipboardWrite(value):
+                let write = try value.writeRequest()
+                try PeekabooBridgeRequestContext.checkRequestIsActive()
+                var result = PeekabooBridgeClipboardMutation(outcome: "completed", clipboard_changed: false)
+                do {
+                    let written = try self.clipboard.setActionResult(write)
+                    result.native_outcome = written.outcome
+                    result.clipboard_changed = true
+                } catch let failure as DesktopActionFailure {
+                    guard failure.outcome.dispatchState.mutationDispatched else { throw failure }
+                    result.outcome = "unknown"
+                    result.native_outcome = failure.outcome
+                    result.clipboard_changed = true
+                    result.error = .init(code: "CLIPBOARD_WRITE_FAILED", message: failure.message, hint: failure.hint)
+                }
+                return Self.clipboardResponse(result)
+            case let .clipboardPaste(payload):
+                return try await self.pasteClipboard(payload)
+            default:
+                throw Self.invalidRequest(for: request)
+            }
+        }
+    }
+
+    private func pasteClipboard(_ payload: PeekabooBridgeClipboardPasteRequest) async throws -> PeekabooBridgeHandledResponse {
+        guard !payload.snapshot.isEmpty, payload.snapshot.utf16.count <= 256,
+              try await self.services.snapshots.ownsSnapshot(snapshotId: payload.snapshot),
+              let detection = try await self.services.snapshots.getDetectionResult(snapshotId: payload.snapshot),
+              let context = detection.metadata.windowContext,
+              let identity = context.windowMutationIdentity,
+              let bounds = context.windowBounds,
+              context.windowID == identity.windowID,
+              context.applicationProcessId == identity.ownerProcessIdentifier,
+              let focused = context.focusedElement
+        else { throw Self.clipboardRefusal("Inspect an exact window with a focused control before pasting.") }
+        guard let keyboard = self.services.automation as? any ClipboardGuardedExactWindowHotkeyServiceProtocol,
+              keyboard.supportsClipboardGuardedExactWindowHotkeys
+        else { throw Self.clipboardRefusal("The native host cannot bind paste to its clipboard generation and exact focused window.") }
+        let write = try payload.value.writeRequest()
+        // All prior items and representations remain in GUI memory until cleanup. No restore journal survives a crash.
+        guard let transaction = try self.clipboard.prepareTemporaryWrite(
+            maximumBytes: 32 * 1024 * 1024, maximumItems: 128, maximumRepresentations: 512
+        ) as? any ClipboardTemporaryWriteClaimProviding else {
+            throw Self.clipboardRefusal("The native clipboard owner cannot retain a generation claim.")
+        }
+        let lease = try await self.services.snapshots.beginSnapshotMutation(snapshotId: payload.snapshot)
+        var result = PeekabooBridgeClipboardMutation(
+            outcome: "refused", clipboard_changed: false, clipboard_cleanup: "not_needed", consumption: "unverified")
+        result.target_receipt = .init(pid: identity.ownerProcessIdentifier, window_id: identity.windowID,
+                                     process_start_identity_decimal: String(identity.ownerProcessStartIdentity))
+        var attemptedInput = false
+        do {
+            try PeekabooBridgeRequestContext.checkRequestIsActive()
+            let written = try transaction.writeWithClaim(write)
+            try PeekabooBridgeRequestContext.checkRequestIsActive()
+            attemptedInput = true
+            let input = try await keyboard.hotkeyWithOutcome(
+                keys: "cmd,v", holdDuration: 50,
+                target: .init(identity: identity, bounds: bounds, focusedElement: focused),
+                clipboardClaim: written.claim)
+            result.native_outcome = input.outcome
+            guard let outcome = input.outcome,
+                  let target = input.targetIdentity?.exactWindow,
+                  target.identity.hasSameStableReceipt(as: identity), target.bounds == bounds else {
+                throw DesktopActionFailure.indeterminate(evidence: .completionUnknown,
+                    message: "Paste returned without its expected exact-window outcome.")
+            }
+            switch outcome.state {
+            case .refused: result.outcome = "refused"
+            case .partial, .indeterminate: result.outcome = "unknown"
+            default: result.outcome = outcome.evidence == .operationStillRunning ? "unknown" : "completed"
+            }
+            result.requires_fresh_observation = outcome.dispatchState.mutationDispatched
+        } catch let failure as DesktopActionFailure {
+            result.outcome = failure.outcome.dispatchState.mutationDispatched ? "unknown" : "refused"
+            result.native_outcome = failure.outcome
+            result.requires_fresh_observation = failure.outcome.dispatchState.mutationDispatched ||
+                failure.outcome.escalation == .refreshTarget
+            result.error = .init(code: failure.standardErrorCode?.rawValue ?? "DESKTOP_PASTE_FAILED",
+                                 message: failure.message, hint: failure.hint)
+        } catch {
+            result.outcome = attemptedInput ? "unknown" : "refused"
+            result.requires_fresh_observation = attemptedInput
+            result.error = .init(code: "DESKTOP_PASTE_FAILED", message: error.localizedDescription)
+        }
+        result.clipboard_changed = transaction.didMutate
+        // A cancelled/disconnected caller cannot cancel this bounded settle or the synchronous generation-checked restore.
+        if attemptedInput { await ClipboardPasteTransactionGate.waitForPasteConsumption(milliseconds: 150) }
+        do {
+            result.clipboard_cleanup = try transaction.cleanup().status.rawValue
+        } catch {
+            result.clipboard_cleanup = "failed"
+            result.error = .init(code: "CLIPBOARD_CLEANUP_FAILED",
+                                 message: "Restoring the previous clipboard failed; paste delivery is reported separately.")
+        }
+        do {
+            try await self.services.snapshots.finishSnapshotMutation(lease,
+                requiresFreshObservation: result.requires_fresh_observation)
+        } catch {
+            result.requires_fresh_observation = true
+            result.error = .init(code: "SNAPSHOT_FINISH_FAILED",
+                                 message: "The paste result is retained; inspect again before another input.")
+        }
+        guard result.clipboard_changed else {
+            throw Self.clipboardRefusal(result.error?.message ?? "Paste was refused before changing the clipboard.")
+        }
+        return Self.clipboardResponse(result)
+    }
+
+    private static func clipboardResponse(_ result: PeekabooBridgeClipboardMutation) -> PeekabooBridgeHandledResponse {
+        // The outer receipt proves the GUI-owned clipboard transaction; input delivery/cleanup are separate typed facts.
+        .init(response: .clipboardMutation(result), mutation: .init(
+            outcome: .dispatchedUnverified(delivery: ClipboardMutationResultSemantics.delivery,
+                                          evidence: .deliveryAccepted, unitCount: .one), target: .global))
+    }
+
+    private static func clipboardRefusal(_ message: String) -> DesktopActionFailure {
+        .preDispatchRefusal(reason: .targetUnavailable, message: message)
+    }
+}
