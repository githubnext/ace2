+    {
+        guard !representations.isEmpty, representations.count <= 32,
+              representations.allSatisfy({ !$0.isEmpty }),
+              representations.flatMap({ $0 }).reduce(0, { $0 + $1.data.count }) <= 10 * 1024 * 1024
+        else { throw ClipboardValue.invalid("The complete clipboard write exceeds its item or byte limit.") }
+        let items = try representations.map { values in
+            let item = NSPasteboardItem()
+            for value in values {
+                guard item.setData(value.data, forType: .init(value.utiIdentifier)) else {
+                    throw ClipboardServiceError.writeFailed("Could not prepare a clipboard item")
+                }
+            }
+            return item
+        }
+        try Task.checkCancellation()
+        try self.requireTemporaryOwnership(expectedChangeCount)
+        let claimed = self.pasteboard.clearContents()
+        didDispatch = true
+        didClaim(claimed)
+        try self.requireTemporaryOwnership(claimed)
+        guard self.pasteboard.writeObjects(items) else {
+            throw ClipboardServiceError.writeFailed("Could not write the prepared clipboard items")
+        }
+        try self.requireTemporaryOwnership(claimed)
+        let primary = representations[0][0]
+        return .init(utiIdentifier: primary.utiIdentifier, data: primary.data, textPreview: nil)
+    }
+}
