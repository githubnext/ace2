{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "ace-channel",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [{ "name": "CHANNEL", "class_name": "HostedChannel" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostedChannel"] }],
}
